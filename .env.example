# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=mysql+mysqlconnector://user:password@localhost/rdc_onboarding
SECRET_KEY=change-me-to-a-long-random-secret

# Used only by `python seed.py --yes` to create the first SUPER_ADMIN (min 10 characters)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Public address of this app, used for the Approve / Reject / Open links inside emails
# (e.g. https://onboarding.yourcompany.com). Must be reachable by the people who get the emails.
# If blank, the address the sender was browsing from is used.
APP_BASE_URL=

# Optional - only needed for the Truein / ZingHR / DVT integrations. Ask whoever
# manages those accounts for the values. There are no defaults.
TRUEIN_ACCESS_KEY=
TRUEIN_SECRET_KEY=
TRUEIN_SUBSCRIPTION_KEY=
ZINGHR_CLIENT_ID=
ZINGHR_CLIENT_SECRET=
DVT_BASE_URL=
DVT_USERNAME=
DVT_PASSWORD=
