# Settings for the Docker setup. Copy to .env.docker and fill in. Never commit the real file.
# (Your normal .env is for running the app directly on a PC and is NOT used by Docker.)

# ── Database (the "db" container in docker-compose.yml) ───────────────────────────────────────
# Pick a password and use the SAME one in DATABASE_URL below. It is only read the first time the
# database volume is created - changing it later does not change the password MySQL already has.
MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-password
MYSQL_DATABASE=rdc_onboarding
# The host name must stay "db" (the container's name on the compose network).
# Letters/digits only in the password keeps this URL simple; otherwise URL-encode special characters.
DATABASE_URL=mysql+mysqlconnector://root:change-me-to-a-long-random-password@db:3306/rdc_onboarding

# ── App ─────────────────────────────────────────────────────────────────────────────────────
# Keep the SAME value as the old server when moving: it signs the Approve/Reject links already
# sitting in people's inboxes and the login cookies.
SECRET_KEY=change-me-to-a-long-random-secret

# Public address people use to reach the app (used for the buttons in approval e-mails). Can also be
# set later in Admin -> Email Settings. If it starts with https:// the login cookies become
# "secure" automatically, which only works when the app really is served over HTTPS.
APP_BASE_URL=

# Number of reverse proxies (nginx, Caddy, a load balancer...) in front of the app. Leave 0 when
# people connect straight to the container's port.
TRUSTED_PROXIES=0

# Leave FLASK_ENV unset. "production" forces secure-only cookies, which breaks login over plain HTTP.

# First SUPER_ADMIN, only used by `docker compose exec app python seed.py --yes` on a brand-new,
# EMPTY database (see DOCKER.md). Do not run seed.py against a database that has data.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# ── E-mail ──────────────────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── Integrations (copy the values from your existing .env) ───────────────────────────────────
TRUEIN_ACCESS_KEY=
TRUEIN_SECRET_KEY=
TRUEIN_SUBSCRIPTION_KEY=
ZINGHR_CLIENT_ID=
ZINGHR_CLIENT_SECRET=
DVT_BASE_URL=
DVT_USERNAME=
DVT_PASSWORD=
